{
  "manifest_version": 3,
  "name": "GitHub ⇄ Graphite",
  "version": "1.0",
  "description": "Switch a pull request between GitHub and Graphite.",
  "permissions": ["activeTab"],
  "background": { "service_worker": "background.js" },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Not on a pull request",
    "default_icon": { "16": "icons/off16.png", "32": "icons/off32.png" }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+G" },
      "description": "Switch between GitHub and Graphite"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*",
        "https://app.graphite.dev/*",
        "https://app.graphite.com/*"
      ],
      "js": ["switch.js", "content.js"]
    }
  ]
}
